<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#02050B" android:centerColor="#09172B" android:endColor="#030711" />
        </shape>
    </item>
    <item android:gravity="center" android:width="300dp" android:height="300dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="150dp" android:startColor="#2057E7F2" android:centerColor="#183D2D70" android:endColor="#0002050B" />
        </shape>
    </item>
    <item android:gravity="center" android:width="232dp" android:height="232dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#4057E7F2" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:gravity="center" android:width="194dp" android:height="194dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#40A58BFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:gravity="center" android:width="156dp" android:height="156dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="78dp" android:startColor="#50FFC857" android:centerColor="#2057E7F2" android:endColor="#00050914" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_empire_foreground" android:gravity="center" android:width="168dp" android:height="168dp" />
</layer-list>
